# Copy to .env for local development. Never commit real values.

# LLM (https://console.groq.com). The key is read from the environment only; never put it in code or commit it.
GROQ_API_KEY=
# Check which models your key can use: GET https://api.groq.com/openai/v1/models
GROQ_MODEL=qwen/qwen3.8-27b           # tutor answers
GROQ_FAST_MODEL=openai/gpt-oss-20b    # intent, NLI judge, study aids (small and quick)
GROQ_REASONING_EFFORT=default         # main model: default | low | medium | high
GROQ_FAST_REASONING_EFFORT=low        # fast model: low | medium | high
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.95
LLM_MAX_TOKENS=2048                   # per generation segment; the harness continues automatically if a reply hits it
LLM_MAX_CONTINUATIONS=3               # extra segments allowed per answer (total budget ~ MAX_TOKENS x (1 + this))
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_CONTEXT_CHAR_BUDGET=24000         # prompt size cap (chars); oldest history is dropped first

# Tutor harness
INPUT_MAX_CHARS=4000
NLI_ENABLED=true
NLI_ENTAIL_THRESHOLD=0.6              # a claim is "supported" only at/above this entailment confidence
NLI_CONTRADICT_THRESHOLD=0.5
NLI_MIN_SUPPORTED_RATIO=0.5
# MCP tools: both must be set, otherwise no MCP tool can ever run. Comma-separated.
MCP_SERVER_URLS=
MCP_TOOL_ALLOWLIST=
MCP_TIMEOUT_SECONDS=8

# Rate limiting (in-process; per instance)
RATE_LIMIT_ENABLED=true
TUTOR_RATE_PER_MINUTE=12              # per user
TUTOR_RATE_PER_HOUR=120
TUTOR_MAX_CONCURRENT_STREAMS=2        # open answer streams per user
GLOBAL_LLM_RATE_PER_MINUTE=90         # whole service; keep below your Groq plan's limit
TRUST_PROXY_HEADERS=true              # key anonymous callers by the proxy-added X-Forwarded-For entry

# Auth: shared secret between the Next.js server and this service
AI_BACKEND_TOKEN=
# Set true locally to allow requests without the token
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Postgres (Supabase). Pooled URL for runtime, direct URL for migrations
DATABASE_URL=
DIRECT_URL=

# Vector search (optional: without a Pinecone key, document search runs on Postgres)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=entropy-ai
PINECONE_ENV=us-east-1

# Knowledge graph (Neo4j AuraDB Free, or bolt://localhost:7687 with docker-compose)
# AuraDB: paste the values from the credentials file the console gives you (NEO4J_USERNAME and NEO4J_DATABASE are
# both the instance id). NEO4J_USER is the fallback name for a self-hosted server.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Optional
TAVILY_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=documents
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
