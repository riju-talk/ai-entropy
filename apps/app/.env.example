# Copy to .env.local for local development. Never commit real values.

# Postgres (Supabase). Runtime uses the pooled (port 6543) URL; migrations use the direct one.
# Serverless needs ?pgbouncer=true&connection_limit=1 on the pooled URL or Vercel will exhaust connections.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# NextAuth
NEXTAUTH_URL=http://localhost:5000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=

# AI service (FastAPI on Render). Server-side only: do NOT prefix with NEXT_PUBLIC_
BACKEND_URL=http://localhost:8000
# Must equal AI_BACKEND_TOKEN on the AI service
AI_BACKEND_TOKEN=

# Public site URL used for metadata (safe to expose)
NEXT_PUBLIC_APP_URL=http://localhost:5000

# LOCAL ONLY: adds password-free "Demo accounts" (student@local.dev etc.) that skip Google/GitHub.
# In a production build it only works when NEXTAUTH_URL is localhost, so it cannot be enabled on Vercel.
ENABLE_DEV_LOGIN=false

# Demo mode (default on): each account may keep at most 5 chat sessions and must delete one to add another.
# Set to false to remove the cap.
DEMO_MODE=true
